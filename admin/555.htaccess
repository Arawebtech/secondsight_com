
# =========================================================
# BASIC SECURITY
# =========================================================

<FilesMatch "^(\.htaccess|\.env|.*\.ini|.*\.log|.*\.sh|.*\.bash)$">
    Require all denied
</FilesMatch>

Options -Indexes


# =========================================================
# REWRITE
# =========================================================

<IfModule mod_rewrite.c>

    RewriteEngine On


    # =====================================================
    # LOCALHOST / XAMPP
    # No HTTPS or WWW redirect on localhost
    # =====================================================

    RewriteCond %{HTTP_HOST} ^localhost$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^127\.0\.0\.1$ [NC]
    RewriteRule ^ - [L]


    # =====================================================
    # LIVE WEBSITE
    # Force HTTPS + WWW
    # =====================================================

    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteCond %{HTTP_HOST} !^www\.secondsightfoundation\.com$ [NC]
    RewriteRule ^ https://www.secondsightfoundation.com%{REQUEST_URI} [R=301,L]


    # =====================================================
    # LOGIN
    # /admin/login -> /admin/index.php
    # =====================================================

    RewriteRule ^login/?$ index.php [L]


    # =====================================================
    # PRETTY URLs
    # =====================================================

    RewriteRule ^blog/([^/]+)/?$ blog_details.php?blog_url=$1 [L,QSA]

    RewriteRule ^courses/([^/]+)/?$ courses_details.php?courses_url=$1 [L,QSA]

    RewriteRule ^profile/([^/]+)/([0-9]+)/?$ course_lesson.php?course_url=$1&courseId=$2 [L,QSA]

    RewriteRule ^team/([^/]+)/?$ team_details.php?team_url=$1 [L,QSA]


    # =====================================================
    # EXISTING FILES / DIRECTORIES
    # =====================================================

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]


    # =====================================================
    # EVERYTHING ELSE -> index.php
    # =====================================================

    RewriteRule ^ index.php [L]

</IfModule>


# =========================================================
# ERROR PAGES
# =========================================================

ErrorDocument 403 /admin/403.html
ErrorDocument 404 /admin/404.html


# =========================================================
# SECURITY HEADERS
# =========================================================

<IfModule mod_headers.c>

    Header always set X-Frame-Options "DENY"

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-XSS-Protection "1; mode=block"

</IfModule>


# =========================================================
# GZIP COMPRESSION
# =========================================================

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json

</IfModule>


# =========================================================
# BROWSER CACHE
# =========================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"

    ExpiresByType text/css "access plus 7 days"

    ExpiresByType application/javascript "access plus 7 days"

    ExpiresByType application/pdf "access plus 30 days"

    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresDefault "access plus 2 days"

</IfModule>

